<div class="campo">
    <label for="nome">Nome completo:</label>
    <input type="text" id="nome" name="nome" required maxlength="100" value="<%= dados.nome || '' %>" placeholder="Ex: Ana Beatriz Santos">
</div>
<div class="campo">
    <label for="cpf">CPF:</label>
    <input type="text" id="cpf" name="cpf" required maxlength="14" value="<%= dados.cpf || '' %>" placeholder="000.000.000-00">
</div>
<div class="campo">
    <label for="email">E-mail:</label>
    <input type="email" id="email" name="email" required maxlength="120" value="<%= dados.email || '' %>" placeholder="nome@email.com">
</div>
<div class="campo">
    <label for="telefone">Telefone:</label>
    <input type="text" id="telefone" name="telefone" required maxlength="20" value="<%= dados.telefone || '' %>" placeholder="(11) 90000-0000">
</div>
